      "id": "1579196d-ca8b-41c2-ba41-ebe150a35223",
      "name": "Lệnh Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        -3820,
        1360
      ],
      "webhookId": "ca6994f8-0322-4ef4-8d4d-7337b3c8de10",
