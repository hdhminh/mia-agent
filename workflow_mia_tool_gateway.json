    {
      "parameters": {
        "jsCode": "const source = $('Prepare Tool Request').item.json || {};\nconst output = $json || {};\nconst raw = String(output.text || output.output || output.response || '').replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\nconst text = raw || JSON.stringify(output);\nreturn [{ json: { ok: true, tool: source.tool || '', workflowKey: source.workflowKey || '', requestId: source.requestId || '', text, data: output } }];"
      },
