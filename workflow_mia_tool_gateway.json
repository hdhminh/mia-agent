      },
      "id": "mia-tool-webhook",
      "name": "Webhook Tool Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -1600,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Webhook Tool Request').item.json || {};\nconst body = source.body || source;\nconst headers = source.headers || {};\nconst expectedToken = String($env.MIA_TOOL_GATEWAY_TOKEN || '').trim();\nconst providedToken = String(headers['x-mia-tool-token'] || headers['X-Mia-Tool-Token'] || '').trim();\n\nif (expectedToken && providedToken !== expectedToken) {\n  return [{ json: { ok: false, error: 'Unauthorized tool gateway token.' } }];\n}\n\nconst tool = String(body.tool || '').trim();\nconst args = body.args && typeof body.args === 'object' ? body.args : {};\nconst requestId = String(body.requestId || '').trim();\nconst originChatId = String(body.chatId || '').trim();\nconst deliveryMode = String(body.deliveryMode || 'return').trim() || 'return';\nconst backendChatId = deliveryMode === 'telegram' ? originChatId : '';\n\nfunction clean(value) {\n  return String(value || '').trim();\n}\n\nfunction buildText() {\n  switch (tool) {\n    case 'weather.get':\n      return { workflowKey: 'weather', text: `thời tiết ${clean(args.location)}`.trim() };\n    case 'gold.get_price':\n      return { workflowKey: 'gold', text: 'giá vàng hôm nay' };\n    case 'news.get':\n      return { workflowKey: 'news', text: clean(args.topic) ? `tin tức ${clean(args.topic)}` : 'tin tức hôm nay' };\n    case 'search.web':\n      return { workflowKey: 'search', text: `tìm kiếm ${clean(args.query)}`.trim() };\n    case 'calendar.assistant':\n      return { workflowKey: 'calendar', text: clean(args.instruction) };\n    case 'gmail.assistant':\n      return { workflowKey: 'gmail', text: clean(args.instruction) };\n    case 'drive.assistant':\n      return { workflowKey: 'drive', text: clean(args.instruction) };\n    case 'docs.assistant':\n      return { workflowKey: 'docs', text: clean(args.instruction) };\n    case 'sheets.assistant':\n      return { workflowKey: 'sheets', text: clean(args.instruction) };\n    case 'shortlink.create': {\n      const url = clean(args.url);\n      const ttl = clean(args.ttl);\n      return { workflowKey: 'shortlink', text: ttl ? `rut gon link ${url} ${ttl}` : `rut gon link ${url}` };\n    }\n    default:\n      return null;\n  }\n}\n\nif (!tool) {\n  return [{ json: { ok: false, error: 'Missing tool name.' } }];\n}\n\nconst built = buildText();\nif (!built || !built.text) {\n  return [{ json: { ok: false, error: `Unsupported or invalid tool request: ${tool}` } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    tool,\n    workflowKey: built.workflowKey,\n    text: built.text,\n    rawText: built.text,\n    chatId: backendChatId,\n    originChatId,\n    requestId,\n    deliveryMode,\n    args,\n    payload: { tool, args, requestId, originChatId, deliveryMode },\n    message: { text: built.text, caption: built.text }\n  }\n}];"
      },
