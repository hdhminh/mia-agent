    {
      "parameters": {
        "jsCode": "// ============================================================\n// KEYWORD PRE-FILTER — Hỗ trợ 3B Gatekeeper\n// Nếu nhận ra keyword rõ ràng → short-circuit, bỏ qua 3B\n// Nếu mơ hồ → route UNKNOWN → 3B Gatekeeper xử lý như cũ\n// ============================================================\nconst message = $json.message || {};\nconst raw = String(message.text || message.caption || '').trim();\n\nfunction normalize(str) {\n  return String(str || '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/\\u0111/g, 'd')\n    .replace(/\\u0110/g, 'D');\n}\nconst text = normalize(raw);\n\n// HIGH-CONFIDENCE TOOL keywords\nconst hasTool =\n  /(vang|gold|sjc|9999|gia vang|xem vang)/.test(text) ||\n  /(tin tuc|doc bao|bao hom nay|news|vnexpress|bao moi|xem bao)/.test(text) ||\n  /(thoi tiet|weather|nhiet do|do am|du bao|forecast|mua khong|nang khong)/.test(text) ||\n  /\\b(calendar|xem lich|lich hom nay|tao lich|dat lich|su kien|meeting)\\b/.test(text) ||\n  /\\b(gmail|xem mail|doc mail|gui mail|check mail|inbox)\\b/.test(text) ||\n  /\\b(google drive|tim file|upload file|share file|tao folder)\\b/.test(text) ||\n  /\\b(google docs|tao doc|tao tai lieu|xem doc)\\b/.test(text) ||\n  /\\b(google sheets|tao sheet|tao bang tinh|cap nhat o)\\b/.test(text) ||\n  /\\b(shortlink|rut gon link|link ngan)\\b/.test(text) ||\n  /\\b(tim kiem|tra cuu|wikipedia|cho toi biet|thong tin ve|lich su|dinh nghia|la gi|ai la|o dau)\\b/.test(text);\n\n// HIGH-CONFIDENCE CHAT patterns\nconst hasChat =\n  /^(hi|hello|xin chao|chao|hey|yo|haha|hehe|ok|okay|oke|thanks|cam on|great|tuyet|buon|vui|mia oi|chao mia)/.test(text) ||\n  (text.length < 20 && !hasTool);\n\nif (hasTool) {\n  return [{ json: { ...$json, _route: 'TOOL' } }];\n} else if (hasChat) {\n  return [{ json: { ...$json, _route: 'CHAT' } }];\n} else {\n  // Không chắc → để 3B Gatekeeper phán\n  return [{ json: { ...$json, _route: 'UNKNOWN' } }];\n}"
      },
      "id": "keyword-prefilter",
      "name": "Keyword Pre-filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4150,
        1360
      ]
    },
