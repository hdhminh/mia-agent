{
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -800,
        300
      ]
    },
    {
      "parameters": {
        "text": "Bạn là công cụ phân loại văn bản tự động. Hãy đọc tin nhắn của người dùng và phân loại thành 2 nhóm:\n- Nếu tin nhắn là chào hỏi, cảm xúc, tán gẫu, khen chê bâng quơ -> Phân loại là: CHAT\n- Nếu tin nhắn yêu cầu tính toán, tra cứu thời tiết, tra cứu giá vàng, đọc báo, hoặc hỏi kiến thức phức tạp -> Phân loại là: TOOL\n\nTuyệt đối chỉ in ra đúng 1 từ duy nhất là CHAT hoặc TOOL. Không được giải thích thêm.\n\n--- Các ví dụ ---\nNgười dùng: Xin chào buổi sáng!\nAI: CHAT\n\nNgười dùng: Vàng SJC nay giảm hay tăng thế?\nAI: TOOL\n\nNgười dùng: Bạn ơi mình buồn quá.\nAI: CHAT\n\nNgười dùng: Thời tiết Hà Nội hôm nay sao?\nAI: TOOL\n\n--- Lượt của bạn ---\nNgười dùng: {{ $('Execute Workflow Trigger').item.json.text || $('Execute Workflow Trigger').item.json.message?.text }}\nAI:"
      },
      "id": "gatekeeper",
      "name": "3B Gatekeeper (Phân loại)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -500,
        300
      ]
    },
    {
      "parameters": {
        "model": "qwen2.5:3b",
        "options": {
          "temperature": 0
        }
      },
      "id": "ollama-model-3b",
      "name": "Ollama Qwen 3B",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -500,
        500
      ],
      "credentials": {
        "ollamaApi": {
          "id": "pmqhUd4rRmQaVRW1",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.text }}",
        "rules": {
          "rules": [
            {
              "operation": "contains",
              "value2": "TOOL",
              "output": 1
            }
          ]
        },
        "fallbackOutput": 0
      },
      "id": "switch",
      "name": "Safe Router Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Execute Workflow Trigger').item.json.text || $('Execute Workflow Trigger').item.json.message?.text }}",
        "options": {
          "systemMessage": "Bạn là Mia, một trợ lý AI trẻ trung, thân thiện và thấu hiểu. Nhiệm vụ của bạn là trò chuyện, tâm sự và mang lại niềm vui cho người dùng. Hãy luôn xưng hô là 'Mia' và gọi người dùng là 'bạn' hoặc 'anh/chị'. Trả lời ngắn gọn, tự nhiên, vui vẻ bằng tiếng Việt."
        }
      },
      "id": "chat-agent",
      "name": "Groq Chat Agent (Tán gẫu)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        100,
        100
      ]
    },
    {
      "parameters": {
        "model": "llama-3.1-8b-instant",
        "options": {
          "baseURL": "https://api.groq.com/openai/v1"
        }
      },
      "id": "groq-model",
      "name": "Groq API",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
