{
  "name": "Sub-workflow: Google Drive - Delete Folder",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-delete-folder",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Execute Workflow Trigger').item.json || {};\nconst payload = source.payload || {};\nconst message = source.message || payload.message || payload.body?.message || {};\nconst chatId = source.chatId || message.chat?.id || payload.chatId || '';\nconst raw = String(source.rawText || message.text || payload.text || '').trim();\nconst folderId = source.folderId || payload.folderId || source.fileId || payload.fileId || '';\nconst folderName = String(source.folderName || payload.folderName || raw.replace(/^(xoa folder|xoa thu muc|delete folder|delete directory)\\s*/i, '')).trim();\nreturn [{ json: { ...source, payload, message, chatId, raw, folderId, folderName, hasTarget: Boolean(folderId || folderName), response: (folderId || folderName) ? '' : '🗑️ <b>Xoa folder</b>\\n\\nVi du: xoa folder Du an cu' } }];"
      },
      "id": "prepare-delete-folder",
      "name": "Prepare Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasTarget }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-delete-folder-target",
      "name": "Co Folder De Xoa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.folderId) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-delete-folder-id",
      "name": "Co Folder ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        704,
        0
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"name contains '\" + String($json.folderName || '').replace(/'/g, \"\\\\'\") + \"' and mimeType = 'application/vnd.google-apps.folder' and trashed = false\" }}",
        "returnAll": false,
        "limit": "={{ 1 }}",
        "filter": {
          "driveId": {
            "mode": "list",
            "value": "My Drive"
          },
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.parentFolderId || 'root' }}"
          },
          "whatToSearch": "all",
          "includeTrashed": false
        },
        "options": {
          "fields": [
            "*"
          ]
        }
      },
      "id": "search-delete-folder",
      "name": "Drive Tim Folder Xoa",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        944,
        -120
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const source = $('Prepare Action').item.json || {};\nconst rows = $input.all().map((item) => item.json || {}).filter((item) => item.id || item.name);\nif (!rows.length) {\n  return [{ json: { ...source, folderId: '', response: 'Khong tim thay folder phu hop.' } }];\n}\nconst folder = rows[0];\nreturn [{ json: { ...source, folderId: folder.id || source.folderId || '', folderName: folder.name || source.folderName || '', webViewLink: folder.webViewLink || '', mimeType: folder.mimeType || '' } }];"
      },
      "id": "resolve-delete-folder",
      "name": "Resolve Search Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.folderId) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-delete-folder-resolved",
      "name": "Tim Thay Folder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1392,
        -120
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "update",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.folderId }}"
        },
        "changeFileContent": false,
        "newUpdatedFileName": "",
        "options": {
          "trashed": true,
          "fields": [
            "*"
          ]
        }
      },
      "id": "trash-delete-folder",
      "name": "Drive Trash Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        944,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const escapeHtml = (value = '') => String(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;');\nconst source = $('Prepare Action').item.json || {};\nconst item = $input.item.json || {};\nconst folderName = item.name || source.folderName || 'Khong ro ten';\nconst folderId = item.id || source.folderId || '';\nconst link = item.webViewLink || source.webViewLink || '';\n\nlet text = '🗑️ <b>Da dua folder vao thung rac</b>\\n\\n';\ntext += '<b>' + escapeHtml(folderName) + '</b>\\n';\nif (folderId) text += 'ID: <code>' + escapeHtml(folderId) + '</code>\\n';\nif (link) text += '🔗 <a href=\"' + escapeHtml(link) + '\">Mo folder</a>';\n\nreturn [{ json: { chatId: source.chatId, text: text.trim() } }];"
      },
      "id": "format-delete-folder",
      "name": "Format Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text ?? $json.response }}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            },
            {
              "name": "disable_web_page_preview",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "send-delete-folder",
      "name": "Gui Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1648,
        0
      ]
    }
  ],
