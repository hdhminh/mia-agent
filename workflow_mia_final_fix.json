        "telegramApi": {
          "id": "Iw1sMhOVNbp773Qu",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Lệnh Telegram').item.json.message.text || $('Lệnh Telegram').item.json.message.caption || '' }}",
        "options": {
          "systemMessage": "Bạn là Mia, trợ lý AI chuyên nghiệp.\n\nNHIỆM VỤ:\n- Bạn dùng cùng một mô hình để vừa trò chuyện vừa quyết định có cần tool hay không.\n- Nếu không cần tool, hãy tự trả lời trực tiếp, ngắn gọn, tự nhiên bằng tiếng Việt.\n- Nếu cần tool, hãy gọi đúng tool phù hợp.\n\nQUY TẮC KHI DÙNG TOOL:\n1. Mỗi tool sẽ tự gửi kết quả cuối cùng cho người dùng qua Telegram.\n2. Sau khi tool chạy thành công, câu trả lời cuối cùng của bạn phải chính xác là [TOOL_DELIVERED].\n3. Không được lặp lại, tóm tắt lại, hay gửi lại nội dung mà tool vừa gửi.\n4. Nếu tool thất bại, hãy xin lỗi ngắn gọn và tự trả lời nếu có thể.\n5. Luôn xưng 'Mia', gọi người dùng là 'bạn'.\n6. Không lộ quá trình suy nghĩ. Không in ra <think>.",
          "maxIterations": 4
        }
      },
      "id": "a6dd5e55-c42c-4024-a70e-1013fd7b0374",
      "name": "OpenRouter Tool Agent (Làm việc)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        -3300,
