{
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-node",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [ 0, 300 ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Execute Workflow Trigger').item.json.rawText || $('Execute Workflow Trigger').item.json.text || $('Execute Workflow Trigger').item.json.message?.text || $('Execute Workflow Trigger').item.json.message?.caption || $('Execute Workflow Trigger').item.json.payload?.message?.text || $('Execute Workflow Trigger').item.json.payload?.message?.caption || ($('Execute Workflow Trigger').item.json.fileName ? '[file] ' + $('Execute Workflow Trigger').item.json.fileName : '') || '[non-text telegram message]' }}",
        "options": {
          "systemMessage": "Bạn là chuyên gia AI thông minh của hệ thống. Bạn có khả năng sử dụng các công cụ (tools) được cung cấp để thực hiện các hành động phức tạp. Hãy sử dụng tool khi cần thiết, và trả lời bằng tiếng Việt thật tự nhiên, thân thiện."
        }
      },
      "id": "agent-node",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [ 300, 300 ]
    },
    {
      "parameters": {
        "model": "deepseek/deepseek-v4-flash",
        "options": {
          "baseURL": "https://openrouter.ai/api/v1"
        }
      },
      "id": "model-node",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [ 300, 500 ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Execute Workflow Trigger').item.json.message?.chat?.id || 'default' }}_agent",
        "contextWindowLength": 5
      },
      "id": "memory-node",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [ 450, 500 ]
    },
    {
      "parameters": {
        "name": "check_gold_price",
        "description": "Gọi tool này khi người dùng hỏi về thông tin giá vàng, vàng SJC, vàng 9999.",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        }
      },
      "id": "tool-gold",
      "name": "Call Workflow: Vàng",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.1,
      "position": [ 600, 500 ]
    },
    {
      "parameters": {
        "name": "check_weather",
        "description": "Gọi tool này khi người dùng hỏi về thời tiết, dự báo, nhiệt độ, độ ẩm.",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        }
      },
      "id": "tool-weather",
      "name": "Call Workflow: Thời Tiết",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.1,
      "position": [ 750, 500 ]
    },
    {
      "parameters": {
        "name": "search_news",
        "description": "Gọi tool này khi người dùng yêu cầu đọc báo, tin tức mới nhất hôm nay.",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        }
      },
      "id": "tool-news",
      "name": "Call Workflow: Tin Tức",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.1,
      "position": [ 900, 500 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $('Execute Workflow Trigger').item.json.chatId || $('Execute Workflow Trigger').item.json.message?.chat?.id || $('Execute Workflow Trigger').item.json.payload?.message?.chat?.id }}"
            },
            {
              "name": "text",
              "value": "={{ $json.output }}"
            }
          ]
        },
        "options": {}
      },
      "id": "telegram-node",
      "name": "Gui Tin Nhan Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 600, 300 ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Gui Tin Nhan Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Call Workflow: Vàng": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Call Workflow: Thời Tiết": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Call Workflow: Tin Tức": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  }
}
