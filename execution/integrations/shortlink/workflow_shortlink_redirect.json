{
  "name": "Public: Short Link Redirect",
  "nodes": [
    {
      "parameters": {
        "path": "shortlink/go",
        "httpMethod": "GET",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "shortlink-go-webhook",
      "name": "Webhook Redirect",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Webhook Redirect').item.json || {};\nconst query = source.query || {};\nconst id = String(query.id || source.params?.id || '').trim();\nif (!id) {\n  return [{ json: { ok: false, responseCode: 400, result: 'Short link id missing' } }];\n}\nif (!/^[a-z0-9]{8,12}$/i.test(id)) {\n  return [{ json: { ok: false, responseCode: 400, result: 'Invalid short link id' } }];\n}\nreturn [{ json: { ok: true, id, lookupSql: `SELECT id, long_url, short_url, host, clicks, created_at, expires_at, updated_at, last_clicked_at FROM short_links WHERE id = '${id}' LIMIT 1;` } }];"
      },
      "id": "shortlink-go-prepare",
      "name": "Prepare Redirect Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "shortlink-go-valid-id",
      "name": "ID Hop Le?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.lookupSql }}",
        "options": {}
      },
      "id": "shortlink-go-find",
      "name": "Find Link By ID",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        720,
        -120
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "XIYO79FxACZ0XHMP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Prepare Redirect Request').item.json || {};\nconst rows = $input.all().map((item) => item.json || {}).filter((row) => row.id);\nconst row = rows[0] || null;\nif (!row) {\n  return [{ json: { ok: false, responseCode: 404, result: 'Short URL not found' } }];\n}\nconst expired = Boolean(row.expires_at && new Date(row.expires_at).getTime() <= Date.now());\nif (expired) {\n  return [{ json: { ok: false, responseCode: 410, result: 'Short URL expired' } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    id: row.id,\n    redirectUrl: row.long_url,\n    updateSql: `UPDATE short_links SET clicks = clicks + 1, last_clicked_at = now(), updated_at = now() WHERE id = '${row.id}' RETURNING id, long_url, short_url, host, clicks, created_at, expires_at, updated_at, last_clicked_at;`\n  }\n}];"
      },
      "id": "shortlink-go-decide",
      "name": "Decide Redirect Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "shortlink-go-can-redirect",
      "name": "Can Redirect?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.updateSql }}",
        "options": {}
      },
      "id": "shortlink-go-update",
      "name": "Update Clicks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1440,
        -240
      ],
      "credentials": {
        "postgres": {
          "id": "XIYO79FxACZ0XHMP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Decide Redirect Result').item.json || {};\nconst row = $input.item.json || {};\nreturn [{ json: { redirectUrl: row.long_url || source.redirectUrl || '' } }];"
      },
      "id": "shortlink-go-build-redirect",
      "name": "Build Redirect Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -240
      ]
    },
    {
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "={{ $json.redirectUrl }}",
        "options": {
          "responseCode": 302
        }
      },
      "id": "shortlink-go-respond-redirect",
      "name": "Respond Redirect",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1920,
        -240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.responseCode === 410 }}",
              "value2": true
            }
          ]
        }
      },
      "id": "shortlink-go-expired",
      "name": "Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1440,
        40
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.result }}",
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "shortlink-go-respond-400",
