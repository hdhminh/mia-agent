    {
      "parameters": {
        "jsCode": "const source = $('Execute Workflow Trigger').item.json || {};\nconst text = '📅 <b>Google Calendar</b>\\n\\nMình hỗ trợ các tác vụ sau:\\n- tạo lịch: tạo lịch họp team lúc 15h mai\\n- lịch hôm nay\\n- lịch ngày mai\\n- tìm lịch họp khách\\n- xoá lịch họp khách\\n- kiểm tra lịch rảnh 9h-10h mai';\nreturn [{ json: { chatId: source.chatId, text } }];"
      },
      "id": "calendar-help",
      "name": "Huong Dan Calendar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botyour_telegram_bot_token/sendMessage",
