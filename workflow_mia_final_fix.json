      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $('Lệnh Telegram').item.json.message.chat.id }}"
            },
            {
              "name": "text",
              "value": "={{ (() => { const raw = String($json.output || $json.text || '').replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim(); if (!raw || raw === '[TOOL_DELIVERED]') return 'Xin lỗi, Mia chưa gửi được phản hồi. Bạn thử lại nhé 😊'; return raw; })() }}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            },
            {
              "name": "disable_web_page_preview",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
