{
  "name": "Sub-workflow: Notify Telegram",
  "nodes": [
    {
      "parameters": {},
      "id": "n1-notify-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.item.json || {};\nconst args = input.args || {};\nreturn [{ json: { chatId: String(input.chatId || args.chatId || $env.TELEGRAM_ADMIN_CHAT_ID || '').trim(), text: String(input.text || args.text || 'Bạn có nhắc mới').trim() } }];"
      },
      "id": "n2-prepare",
      "name": "Chuẩn Bị Tin Nhắn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "disable_web_page_preview",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "n3-send",
      "name": "Gửi Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json || {};\nconst okBody = body.ok === true || (body.result && body.result.ok === true);\nconst chatId = String(body.chatId || '');\nreturn [{ json: { ok: okBody, delivered: okBody, chatId, text: okBody ? 'Đã gửi nhắc thành công.' : 'Gửi Telegram thất bại.' } }];"
      },
      "id": "n4-ack",
      "name": "Xác Nhận Gửi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $input.item.json || {};\nfunction decodeEntities(value = '') {\n  return String(value).replace(/&amp;/gi, '&').replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&quot;/gi, '\"').replace(/&#39;/gi, \"'\").replace(/&nbsp;/gi, ' ');\n}\nconst ok = Boolean(source.ok);\nconst text = decodeEntities(String(source.text ?? '')).replace(/<[^>]+>/g, ' ').replace(/\\s{2,}/g, ' ').trim();\nreturn [{ json: { ok, text, data: { delivered: Boolean(source.delivered), chatId: source.chatId || '' } } }];"
      },
      "id": "n5-normalize",
      "name": "Chuẩn Hóa Kết Quả",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Chuẩn Bị Tin Nhắn",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chuẩn Bị Tin Nhắn": {
      "main": [
        [
          {
            "node": "Gửi Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gửi Telegram": {
      "main": [
        [
          {
            "node": "Xác Nhận Gửi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Xác Nhận Gửi": {
      "main": [
        [
          {
            "node": "Chuẩn Hóa Kết Quả",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}