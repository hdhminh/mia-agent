    {
      "parameters": {
        "jsCode": "let chatId = 'ĐIỀN_CHAT_ID_CỦA_BẠN_VÀO_ĐÂY';\nlet isAuto = true;\n\ntry {\n  const msg = $('Execute Workflow Trigger').item.json.message;\n  if (msg && msg.chat && msg.chat.id) {\n    chatId = msg.chat.id;\n    isAuto = false;\n  }\n} catch(e) {}\n\nreturn [{ json: { chatId: chatId, isAuto: isAuto } }];"
      },
      "id": "code-prepare",
      "name": "Chuẩn bị ChatID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://giavang.now/api/prices?type=SJL1L10",
        "options": {}
      },
      "id": "fetch-gold",
      "name": "Lấy Giá Vàng SJC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        656,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Chuẩn bị ChatID').item.json || {};\nconst data = $json || {};\nconst chatId = source.chatId || '';\n\nconst escapeHtml = (value = '') => String(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;');\n\nconst formatPrice = (value) => {\n  const amount = Number(value || 0);\n  if (!Number.isFinite(amount) || amount <= 0) return 'N/A';\n  return `${amount.toLocaleString('vi-VN')} đ/lượng`;\n};\n\nconst formatChange = (value) => {\n  const amount = Number(value || 0);\n  if (!Number.isFinite(amount) || amount === 0) return '0 đ';\n  const sign = amount > 0 ? '+' : '-';\n  return `${sign}${Math.abs(amount).toLocaleString('vi-VN')} đ`;\n};\n\nlet text = '⚠️ Không lấy được giá vàng lúc này. Bạn thử lại sau nhé.';\n\nif (data.success) {\n  const title = data.name || 'SJC 9999';\n  const dateLine = [data.date, data.time].filter(Boolean).join(' ');\n\n  text = `🥇 <b>Giá vàng ${escapeHtml(title)}</b>\\n`;\n  if (dateLine) text += `<i>${escapeHtml(dateLine)}</i>\\n\\n`;\n  text += `🛒 <b>Mua vào:</b> ${escapeHtml(formatPrice(data.buy))}\\n`;\n  text += `💰 <b>Bán ra:</b> ${escapeHtml(formatPrice(data.sell))}\\n`;\n}\n\nreturn [{ json: { chatId, text: text.trim() } }];"
      },
      "id": "format-gold",
      "name": "Tổng Hợp Giá Vàng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
