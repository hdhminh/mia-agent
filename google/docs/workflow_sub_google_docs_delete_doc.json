    {
      "parameters": {
        "jsCode": "function escapeHtml(value = '') {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\\"/g, '&quot;');\n}\n\nconst source = $('Prepare Action').item.json || {};\nconst item = $input.item.json || {};\nconst docId = item.id || source.docId || '';\nconst docName = item.name || source.docName || 'Không rõ tên';\nconst link = item.webViewLink || source.webViewLink || (docId ? `https://docs.google.com/document/d/${docId}/edit` : '');\n\nif (!source.chatId) {\n  throw new Error('Missing chatId while formatting Google Docs delete response.');\n}\n\nlet text = '🗑️ <b>Đã đưa Google Doc vào thùng rác</b>\\n\\n';\ntext += `<b>${escapeHtml(docName)}</b>\\n`;\nif (docId) text += `ID: <code>${escapeHtml(docId)}</code>\\n`;\nif (link) text += `🔗 <a href=\"${escapeHtml(link)}\">Mở tài liệu</a>`;\n\nreturn [{ json: { chatId: source.chatId, text: text.trim() } }];"
      },
